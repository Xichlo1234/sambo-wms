# ===== SAMBO GOLD WMS – Backend =====
NODE_ENV=production
PORT=4000
# Chuỗi kết nối PostgreSQL
DATABASE_URL=postgresql://wms_user:CHANGE_ME@localhost:5432/sambo_wms
# Thời hạn phiên đăng nhập (giờ)
SESSION_TTL_HOURS=12
# Đặt true khi chạy sau HTTPS (Cloudflare Tunnel / Nginx SSL) để cookie chỉ gửi qua HTTPS
COOKIE_SECURE=true
# Nguồn frontend được phép gọi API (để trống nếu frontend được phục vụ cùng domain)
CORS_ORIGIN=
# Thư mục lưu file đính kèm và bản sao lưu (tuyệt đối, nằm ngoài thư mục mã nguồn để cập nhật không ghi đè)
STORAGE_DIR=/var/lib/sambo-wms
# Dung lượng tối đa mỗi file đính kèm (MB)
UPLOAD_MAX_MB=20
# Đường dẫn công cụ PostgreSQL (pg_dump, pg_restore, psql)
PG_BIN_DIR=/usr/bin
# Lịch sao lưu tự động (cron) – mặc định 01:30 hằng ngày; để trống để tắt
BACKUP_CRON=30 1 * * *
# Số bản sao lưu tự động giữ lại
BACKUP_KEEP=30
# Phục vụ frontend đã build từ backend (true khi triển khai 1 máy chủ)
SERVE_CLIENT=true
CLIENT_DIST=../client/dist
